# ── 构建产物 ──
/target/
**/target/
# Legacy target directories remain ignored; new sessions reuse this worktree's target/.
/target-gate/
/target-master/
/target-dualrun/
# 临时输入、导入下载缓存、物化运行包与诊断报告
/.cache/

# 本机相关的 cargo 配置（网络卷开发时 target-dir 重定向到本地盘）
/.cargo/config.toml

# ── 工具 / 编辑器 ──
.DS_Store
# 本地 agent 设置不入库，但 .claude/skills/（可复现的 run skill）入库。
.claude/*
!.claude/skills/
!.claude/skills/**
# 其他 agent 框架的本地配置
/.agents/

# ── 本地 agent 辅助资料（保留在本地盘，不入库）──
# 审计工作产物 / 架构参考文档 / 旧 oracle shim
# （devs/ci、devs/fixtures、devs/scripts 被测试与 skill 引用，仍入库）
/audits/
# Current contracts live in docs/; design drafts and review notes stay local.
/devs/docs/
/devs/tools/
# Agent loop working notes
/.autoloop/
/docs/product-loop.md
/docs/product-loop-memo.md
# 无测试引用的示例 build 文件（召唤奥黛丽黑本.build 被 contract_golden 引用，仍入库）
/examples/build-file/万兽御主.build
/examples/build-file/重生之古灵高手.build

# ── 本地资料（不纳入版本控制）──
# PoB 参考仓库（本地临时 clone，仅用于数据勘察 / 对照）
/vendor/
# 本地研究笔记
/study/
# Historical investigations and machine-specific measurements stay local.
/docs/records/
/docs/adapting-to-0.5.5.md
/docs/adapting-to-0.5.5c.md
/docs/calcs-display-comparison.md
/docs/reference-sources-and-engine-review.md
/docs/wasm-performance.md
/docs/wasm-performance.zh-CN.md
/devs/ci/pob-web-performance-2026-10-12-m4.json
/devs/ci/pob-web-performance-baseline.json
/devs/ci/pob2-refresh-comparison-2026-10-12.json
/devs/ci/pobr-only-performance-2026-10-12-m4.json
/devs/ci/pobr-unpaired-performance-2026-10-12.json
# Build inputs and source metadata remain versioned; generated reports do not.
/examples/reference-builds/*/reports/

# ── Python bytecode cache ──
__pycache__/
*.pyc

# ── 外部导入物：可重建，禁止提交 ──
# 游戏与语言数据只来自 ackness/repoe 与 ackness/poe2-zh-cn-stats 的固定发布，
# 由 `mise run data:prepare` 临时导入（下载按摘要缓存在 /.cache/）；
# `mise run data:check` 确认导入后工作树仍然干净。
# data/ 只跟踪 CURRENT 与 overlay-common/ 中 PoBR 自有规则（check_data_ownership 守卫）。
/data/[0-9]*/
/data/overlay-common/boss_poise_thresholds.json
/data/overlay-common/buff_definitions.json
/data/overlay-common/high_precision_mods.json
/data/overlay-common/item_granted_skills.json
/data/overlay-common/passive_jewel_slots.json
/data/overlay-common/totem_varieties.json
/data/overlay-common/vendor_name_aliases.json
/web/public/data/
/web/src/fixtures/*.json
/web/src/lib/supportDescriptions.zh-CN.json
# 旧版本地原表、树导出与缓存目录：已无读取方，仅防止残留被误提交。
/pipeline/.cache/
/pipeline/node_modules/
/pipeline/tables/
/pipeline/files/
/pipeline/tree/data.json
