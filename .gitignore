# ── 构建产物 ──
/target/
**/target/
# 门禁 / 并行会话隔离 target（CARGO_TARGET_DIR=$PWD/target-* 等）
/target-gate/
/target-master/
/target-dualrun/

# 本机相关的 cargo 配置（网络卷开发时 target-dir 重定向到本地盘）
/.cargo/config.toml

# ── 工具 / 编辑器 ──
# 本地 agent 设置不入库，但 .claude/skills/（可复现的 run skill）入库。
.claude/*
!.claude/skills/
!.claude/skills/**

# ── 本地资料（不纳入版本控制）──
# PoB 参考仓库（本地临时 clone，仅用于数据勘察 / 对照）
/vendor/
# 本地研究笔记
/study/

# ── Python bytecode cache ──
__pycache__/
*.pyc
