+#[test]
+fn conquered_attribute_grants_reproduce_frozen_attribute_deltas() {
+    // Reduced attribute snapshots of frozen ritualist-09 and smith-of-kitava-06.
+    // Keep their actual socket geometry, chosen attributes, seeds and explicit rolls.
+    // Unrelated item/tree BASE terms are combined below; no skills or oracle are needed.
+    let data = data();
+    for (
+        class,
+        attribute,
+        class_base,
+        socket,
+        affected,
+        choices,
+        seed,
+        conqueror,
+        roll,
+        other_base,
+        inc,
+        before,
+        after,
+    ) in [
+        (
+            "Huntress",
+            "Intelligence",
+            7.0,
+            21984,
+            vec![3251, 61403],
+            vec![AttributeChoice::Strength, AttributeChoice::Dexterity],
+            10913,
+            "Tecrod",
+            6,
+            136,
+            3,
+            147.0,
+            160.0,
+        ),
+        (
+            "Warrior",
+            "Strength",
+            15.0,
+            54127,
+            vec![15182, 54282, 54818],
+            vec![AttributeChoice::Strength; 3],
+            2788,
+            "Amanamu",
+            5,
+            223,
+            7,
+            271.0,
+            287.0,
+        ),
+    ] {
+        let conquest = format!(
+            "Glorifying the defilement of {seed} souls in tribute to {conqueror}\nPassives in radius are Conquered by the Abyssals\nHistoric"
+        );
+        let line = format!("Conquered Attribute Passive Skills also grant +{roll} to {attribute}");
+        let options = DataOrchestratorOptions {
+            extra_modifier_texts: vec![
+                format!("+{other_base} to {attribute}"),
+                format!("{inc}% increased {attribute}"),
+            ],
+            ..Default::default()
+        };
+        for (directive, expected) in [("", before), (line.as_str(), after)] {
+            let text = jewel(&format!("{conquest}\n{directive}"));
+            let build = Build::new()
+                .with_character(CharacterIdentity {
+                    level: 100,
+                    class_name: class.into(),
+                    ascendancy_name: String::new(),
+                })
+                .with_tree(PassiveTreeSpec {
+                    allocated_nodes: std::iter::once(socket)
+                        .chain(affected.iter().copied())
+                        .map(NodeId)
+                        .collect(),
+                    attribute_overrides: affected
+                        .iter()
+                        .copied()
+                        .map(NodeId)
+                        .zip(choices.iter().copied())
+                        .collect(),
+                    ..Default::default()
+                })
+                .with_tree_version(Some("0_5".into()))
+                .with_jewels(vec![parse_pob_xml_item(&text).unwrap()])
+                .with_radius_jewels(vec![radius_jewel_from_text(socket, &text).unwrap()]);
+            let calc = calculate_with_data_session(&build, data, &options).unwrap();
+            assert_eq!(
+                calc.attribute_total(attribute, class_base),
+                expected,
+                "{class}: {directive}"
+            );
+            assert_eq!(calc.base_sum("Tribute"), affected.len() as f64 * 3.0);
+            if !directive.is_empty() {
+                assert!(!calc.unsupported_modifier_texts().contains(&line));
+                for id in &affected {
+                    let added: Vec<_> = calc
+                        .mods_named(attribute)
+                        .into_iter()
+                        .filter(|m| {
+                            m.source.as_deref() == Some(format!("+{roll} to {attribute}").as_str())
+                                && m.origin
+                                    .as_ref()
+                                    .is_some_and(|o| o.source_id.id == format!("node.{id}"))
+                        })
+                        .collect();
+                    // Smith's original +5 Strength has the same text as its grant.
+                    assert_eq!(
+                        added
+                            .iter()
+                            .filter_map(|m| m.value.as_number())
+                            .sum::<f64>(),
+                        if attribute == "Strength" { 10.0 } else { 6.0 }
+                    );
+                }
+            }
+        }
+    }
 }
 
