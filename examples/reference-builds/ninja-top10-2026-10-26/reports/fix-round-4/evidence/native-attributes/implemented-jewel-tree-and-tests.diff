+#[test]
+fn conquered_attribute_grants_follow_imported_allocation_and_socket_gates() {
+    let mut data = data().clone();
+    data.passive_nodes = [
+        node(900001, "socket", "Socket", "jewel_socket", 0.0, &[]),
+        node(2, "small", "Small", "normal", 100.0, &[]),
+    ]
+    .into_iter()
+    .chain((3..=7).map(|id| {
+        node(
+            id,
+            "attr",
+            "Attribute",
+            "normal",
+            if id == 7 { 100000.0 } else { 100.0 },
+            &["+5 to any [Attributes|Attribute]"],
+        )
+    }))
+    .map(|n| (n.skill, n))
+    .collect();
+    let text = jewel(
+        "Glorifying the defilement of 10913 souls in tribute to Tecrod\nPassives in radius are Conquered by the Abyssals\nHistoric\nConquered Attribute Passive Skills also grant +6 to Intelligence",
+    );
+    for second in [false, true] {
+        for socket_allocated in [false, true] {
+            let nodes = if socket_allocated {
+                "900001,2,3,4,5,7"
+            } else {
+                "2,3,4,5,7"
+            };
+            let xml = format!(
+                r#"<PathOfBuilding2>
+<Build level="85" className="Witch"/>
+<Tree activeSpec="1"><Spec nodes="{nodes}">
+<WeaponSet1 nodes="4"/><WeaponSet2 nodes="5"/>
+<Sockets><Socket nodeId="900001" itemId="1"/></Sockets>
+<Overrides><AttributeOverride strNodes="3,4,5,6,7"/></Overrides>
+</Spec></Tree>
+<Items activeItemSet="1"><Item id="1">{text}</Item>
+<ItemSet id="1" useSecondWeaponSet="{second}"/></Items>
+</PathOfBuilding2>"#
+            );
+            let build = import_build(&xml).unwrap().build;
+            assert_eq!(build.radius_jewels.len(), usize::from(socket_allocated));
+            let calc =
+                calculate_with_data_session(&build, &data, &DataOrchestratorOptions::default())
+                    .unwrap();
+            assert_eq!(
+                calc.base_sum("Intelligence"),
+                if socket_allocated { 12.0 } else { 0.0 }
+            );
+            let mut sources: Vec<_> = calc
+                .mods_named("Intelligence")
+                .iter()
+                .map(|m| m.origin.as_ref().unwrap().source_id.id.clone())
+                .collect();
+            sources.sort();
+            let expected = if socket_allocated {
+                vec!["node.3", if second { "node.5" } else { "node.4" }]
+            } else {
+                vec![]
+            };
+            assert_eq!(
+                sources, expected,
+                "unallocated, outside-radius and inactive-set nodes cannot grant attributes"
+            );
+        }
+    }
+}
