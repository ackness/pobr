  "items": [
    {
      "inventory_id": "BodyArmour1",
      "additional_text": "护甲、闪避和能量护盾提高 330%\n每个镶嵌的插槽使混沌抗性 +13%\n每个镶嵌的插槽使对你的击中的暴击伤害加成降低 15%\n每个镶嵌的插槽使所有元素抗性 +10%"
    },
    {
      "inventory_id": "Gloves1",
      "additional_text": "+45 能量护盾上限\n能量护盾提高 69%\n+29 智慧\n闪电抗性 +39%"
    },
    {
      "inventory_id": "Belt1",
      "additional_text": "+81 生命上限\n+81 魔力上限\n闪电抗性 +29%\n召唤生物的生命上限提高 22%\n召唤生物的移动速度提高 13%"
    },
    {
      "inventory_id": "Weapon1",
      "additional_text": "物理伤害提高 200%\n攻击速度降低 11%\n+19 力量\n打击造成溅射伤害\n击中时击退敌人\n无法使用投射物攻击"
    },
    {
      "inventory_id": "Helm1",
      "additional_text": "能量护盾提高 32%\n+137 生命上限\n+60 魔力上限\n所有召唤生物技能等级 +2\n冰霜抗性 +27%"
    },
    {
      "inventory_id": "Offhand1",
      "additional_text": "该装备精魂提高 89%\n在场的友军每秒再生 52.8 点生命\n+9 全属性\n伙伴对你的印记目标造成的伤害提高 101%\n你可以拥有任意数量的不同类型的伙伴"
    },
    {
      "inventory_id": "Boots1",
      "additional_text": "+50 能量护盾上限\n火焰抗性 +33%\n冰霜抗性 +27%\n你被冰缓的持续时间降低 42%"
    },
    {
      "inventory_id": "Amulet1",
      "additional_text": "法术伤害提高 23%\n+66 能量护盾上限\n所有元素抗性 +18%"
    },
    {
      "inventory_id": "Ring1",
      "additional_text": "+78 生命上限\n召唤生物的生命上限提高 26%\n召唤生物的伤害提高 21%\n召唤生物的攻击和施法速度提高 8%\n召唤生物的暴击率提高 25%"
    },
    {
      "inventory_id": "Weapon2",
      "additional_text": "物理伤害提高 95%\n移动速度提高 5%\n+15 力量\n+15 智慧\n每个召唤生物使伤害提高 7%"
    },
    {
      "inventory_id": "Ring2",
      "additional_text": "火焰抗性 +29%\n召唤生物的生命上限提高 30%\n召唤生物的伤害提高 21%\n召唤生物有 +22% 元素抗性\n召唤生物的攻击和施法速度提高 10%"
    }
  ],
