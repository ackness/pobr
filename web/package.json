{
  "name": "pobr-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:wasm-contract": "POBR_WASM_CONTRACT=1 vitest run src/hooks/useBuildSession.wasm.test.ts",
    "test:worker": "node --test worker-tests/*.test.mjs",
    "sync-data": "node scripts/sync-data.mjs",
    "package-wasm": "node scripts/package-wasm.mjs",
    "smoke-wasm-package": "node scripts/smoke-wasm-package.mjs",
    "build-tree-art": "python3 scripts/build-tree-art.py",
    "build-wasm": "node scripts/build-wasm.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.62.0",
    "next-themes": "^0.4.6",
    "opencc-js": "^1.4.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "miniflare": "4.20260730.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "pnpm": "12"
  }
}
