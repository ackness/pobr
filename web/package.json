{
  "name": "pobr-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:wasm-contract": "POBR_WASM_CONTRACT=1 vitest run src/hooks/useBuildSession.wasm.test.ts",
    "test:worker": "node --test worker-tests/*.test.mjs",
    "sync-data": "node scripts/sync-data.mjs",
    "package-wasm": "node scripts/package-wasm.mjs",
    "smoke-wasm-package": "node scripts/smoke-wasm-package.mjs",
    "build-tree-art": "python3 scripts/build-tree-art.py",
    "build-wasm": "node scripts/build-wasm.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "miniflare": "4.20260730.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  },
  "engines": {
    "pnpm": "12"
  }
}
