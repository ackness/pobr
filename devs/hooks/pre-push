#!/usr/bin/env bash
set -euo pipefail
if [[ "${POBR_SKIP_PREPUSH:-}" == "1" ]]; then
  echo "Skipping check:pr (POBR_SKIP_PREPUSH=1)."
  exit 0
fi
has_update=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ -n "${local_sha//0/}" ]]; then
    has_update=1
  fi
done
if [[ "$has_update" == "0" ]]; then
  echo "Skipping check:pr (no pushed commits)."
  exit 0
fi
cd "$(git rev-parse --show-toplevel)"
exec mise run check:pr </dev/null
